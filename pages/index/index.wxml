<view class="container">
  <view class="header">
    <view class="city-selector" bindtap="onSwitchCity">
      <text class="city-name">{{currentCity ? currentCity.name : '选择城市'}}</text>
      <text class="arrow">▼</text>
    </view>
    <view class="network-status {{isOnline ? 'online' : 'offline'}}">
      {{isOnline ? '在线' : '离线'}}
    </view>
  </view>

  <view class="weather-card" wx:if="{{loading && !weatherData}}">
    <view class="loading">
      <view class="loading-spinner"></view>
      <text>正在获取天气数据...</text>
    </view>
  </view>

  <view class="weather-card error-card" wx:elif="{{error}}">
    <view class="error-content">
      <text class="error-icon">⚠️</text>
      <text class="error-title">获取天气失败</text>
      <text class="error-message">{{error}}</text>
      <button class="retry-btn" bindtap="onRetry">重试</button>
    </view>
  </view>

  <view class="weather-card" wx:elif="{{weatherData}}">
    <view class="weather-header">
      <text class="update-time">更新于: {{weatherData.updateTime}}</text>
    </view>

    <view class="weather-main">
      <view class="temperature-section">
        <text class="temperature">{{weatherData.current.temperature}}°</text>
        <text class="weather-icon">{{weatherData.current.weatherIcon}}</text>
      </view>
      <text class="weather-desc">{{weatherData.current.weatherDescription}}</text>
    </view>

    <view class="weather-details">
      <view class="detail-item">
        <text class="detail-label">湿度</text>
        <text class="detail-value">{{weatherData.current.humidity}}%</text>
      </view>
      <view class="detail-item">
        <text class="detail-label">风速</text>
        <text class="detail-value">{{weatherData.current.windSpeed}} km/h</text>
      </view>
      <view class="detail-item">
        <text class="detail-label">风向</text>
        <text class="detail-value">{{weatherData.current.windDirection}}风</text>
      </view>
      <view class="detail-item">
        <text class="detail-label">空气质量</text>
        <text class="detail-value">{{weatherData.current.aqi.level}}</text>
      </view>
    </view>

    <view class="hourly-forecast" wx:if="{{weatherData.hourlyForecast.length > 0}}">
      <text class="section-title">24小时预报</text>
      <scroll-view class="hourly-list" scroll-x="true">
        <view class="hourly-item" wx:for="{{weatherData.hourlyForecast}}" wx:key="index">
          <text class="hour-time">{{item.timeStr}}</text>
          <text class="hour-icon">{{item.weatherInfo.icon}}</text>
          <text class="hour-temp">{{item.temperature}}°</text>
        </view>
      </scroll-view>
    </view>

    <view class="daily-forecast" wx:if="{{weatherData.dailyForecast.length > 0}}">
      <text class="section-title">7天预报</text>
      <view class="daily-list">
        <view class="daily-item" wx:for="{{weatherData.dailyForecast}}" wx:key="index">
          <text class="day-name">{{item.weekDay}}</text>
          <text class="day-date">{{item.dateStr}}</text>
          <text class="day-icon">{{item.weatherInfo.icon}}</text>
          <text class="day-temp">{{item.minTemp}}° ~ {{item.maxTemp}}°</text>
        </view>
      </view>
    </view>
  </view>

  <view class="footer">
    <text>数据每 30 秒自动更新</text>
  </view>
</view>
