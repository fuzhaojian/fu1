page {
  background-color: #f5f7fa;
}

.container {
  min-height: 1000px;
  padding-bottom: 80rpx;
  background-color: #f5f7fa;
}

.header {
  padding: 40rpx 20rpx 20rpx;
  background-color: #f5f7fa;
}

.city-select {
  display: flex;
  align-items: center;
  justify-content: center;
  background: white;
  padding: 20rpx 30rpx;
  border-radius: 50rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  max-width: 300rpx;
  margin: 0 auto;
}

.city-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #409eff;
  margin-right: 8rpx;
}

.arrow {
  font-size: 32rpx;
  color: #409eff;
  font-weight: 600;
}

.forecast-section {
  background: white;
  border-radius: 16rpx;
  margin: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #303133;
  margin-bottom: 24rpx;
}

.hourly-scroll {
  white-space: nowrap;
}

.hourly-list {
  display: flex;
  padding-bottom: 10rpx;
}

.hourly-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 100rpx;
  padding: 10rpx 0;
}

.hour-time {
  font-size: 22rpx;
  color: #909399;
  margin-bottom: 8rpx;
}

.hour-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.hour-temp {
  font-size: 26rpx;
  font-weight: 600;
  color: #303133;
}

.daily-list {
  display: flex;
  flex-direction: column;
}

.daily-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 15rpx 0;
}

.day-name {
  font-size: 26rpx;
  font-weight: 600;
  width: 80rpx;
}

.day-date {
  font-size: 22rpx;
  color: #909399;
  width: 80rpx;
}

.day-icon {
  font-size: 40rpx;
}

.day-temp {
  font-size: 26rpx;
  font-weight: 500;
  color: #606266;
}

.action-bar {
  padding: 20rpx;
  text-align: center;
}

.action-btn {
  background: white;
  border: none;
  padding: 20rpx 40rpx;
  border-radius: 50rpx;
  font-size: 26rpx;
  color: #409eff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  display: inline-block;
}

.history-panel {
  background: white;
  border-radius: 16rpx;
  margin: 0 20rpx 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.history-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: #303133;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f7fa;
}

.history-city {
  font-size: 26rpx;
  font-weight: 600;
  width: 120rpx;
}

.history-weather {
  font-size: 26rpx;
  flex: 1;
}

.history-time {
  font-size: 22rpx;
  color: #909399;
}
