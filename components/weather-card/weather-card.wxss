.weather-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border-radius: 24rpx;
  margin: 20rpx;
  padding: 50rpx 40rpx;
  box-shadow: 0 10rpx 40rpx rgba(102, 126, 234, 0.4);
}

.loading-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}

.loading-text {
  color: white;
  font-size: 28rpx;
  margin-top: 30rpx;
}

.error-card {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
}

.error-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.error-text {
  color: white;
  font-size: 26rpx;
  text-align: center;
  margin-bottom: 30rpx;
}

.retry-btn {
  background: white;
  color: #f5576c;
  padding: 16rpx 40rpx;
  border-radius: 50rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.temp-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 40rpx;
}

.main-temp {
  display: flex;
  align-items: baseline;
}

.temp-value {
  font-size: 120rpx;
  font-weight: 300;
  line-height: 1;
}

.temp-unit {
  font-size: 40rpx;
  margin-left: 10rpx;
}

.weather-icon {
  font-size: 100rpx;
}

.weather-desc {
  font-size: 32rpx;
  margin-bottom: 20rpx;
  opacity: 0.9;
}

.city-name-display {
  font-size: 28rpx;
  opacity: 0.8;
  margin-bottom: 30rpx;
}

.info-row {
  display: flex;
  justify-content: space-around;
  padding-top: 30rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.info-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.info-label {
  font-size: 22rpx;
  opacity: 0.7;
  margin-bottom: 8rpx;
}

.info-value {
  font-size: 28rpx;
  font-weight: 600;
}
