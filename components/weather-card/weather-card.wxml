<view class="weather-card">
  <view wx:if="{{loading}}" class="loading-card">
    <text class="weather-icon">🔄</text>
    <text class="loading-text">正在获取天气数据...</text>
  </view>

  <view wx:elif="{{error}}" class="error-card">
    <text class="error-icon">⚠️</text>
    <text class="error-text">{{error}}</text>
    <view class="retry-btn" bindtap="onRetry">重试</view>
  </view>

  <view wx:else>
    <view class="city-name-display">{{weather.cityName}}</view>
    
    <view class="temp-section">
      <view class="main-temp">
        <text class="temp-value">{{weather.current.temperature}}</text>
        <text class="temp-unit">°C</text>
      </view>
      <text class="weather-icon">{{weather.current.weatherIcon}}</text>
    </view>

    <view class="weather-desc">{{weather.current.weatherDescription}}</view>

    <view class="info-row">
      <view class="info-item">
        <text class="info-label">湿度</text>
        <text class="info-value">{{weather.current.humidity}}%</text>
      </view>
      <view class="info-item">
        <text class="info-label">风向</text>
        <text class="info-value">{{weather.current.windDirectionStr}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">风速</text>
        <text class="info-value">{{weather.current.windSpeed}}km/h</text>
      </view>
      <view class="info-item">
        <text class="info-label">空气质量</text>
        <text class="info-value">{{weather.current.aqi.level}}</text>
      </view>
    </view>
  </view>
</view>
